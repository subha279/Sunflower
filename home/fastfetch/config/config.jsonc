{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo/loli.icon",
        "height": 6,
        "padding": {
            "top": 1,
            "left": 3,
            "right": 3
        }
    },
    "display": {
        "separator": "", // Uses a clean Nerd Font arrow instead of a plain colon
        "key": {
            "width": 13 // Perfectly aligns all keys horizontally
        }
    },
    "modules": [
        "break",
        {
            "type": "os",
            "key": "    OS",
            "keyColor": "red",
            "format": "{2}"
        },
        {
            "type": "packages",
            "key": "   󰏗 Pkgs",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "   󰍛 Memory",
            "keyColor": "magenta"
        },
        {
            "type": "disk",
            "key": "   󰋊 Disk",
            "keyColor": "green"
        },
        {
            "type": "command",
            "key": "   󱦟 OS Age",
            "keyColor": "red",
            "text": "birth_time=$(stat -c %W / 2>/dev/null || stat -f %B /); echo $(( ( $(date +%s) - birth_time ) / 86400 )) days"
        },
        {
            "type": "uptime",
            "key": "   󱫐 Uptime",
            "keyColor": "magenta"
        },
        "break"
    ]
}
